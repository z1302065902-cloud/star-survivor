# ===== 爱发电（Afdian）配置 · star-survivor 实例 =====
# user_id：同一爱发电账号所有游戏共用
AFDIAN_USER_ID=20765df8947211f1b18f52540025c377
# token：爱发电开发者后台「生成」（⚠️ 切勿把真实值写进仓库，用下面占位，部署时注入）
AFDIAN_TOKEN=<从爱发电开发者后台获取，部署到 Vercel env>
# 本游戏「完整版 ¥7」方案 plan_id（scripts/query-plans.mjs 拿）
AFDIAN_PLAN_ID=00bdbf36954111f184405254001e7c00

# ===== 数据库（Supabase · star-survivor） =====
# 复用 tower-defense 的库（afdian_orders 表按 plan_id 区分），Transaction pooler 端口 6543
# ⚠️ 密码同样用占位，真实连接串部署到 Vercel env
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# ===== 前端构建注入 =====
# Vercel Aliased 域名（deploy.yml 已配置）
# VITE_AFDIAN_VERIFY_URL=https://star-survivor-mu.vercel.app/api/afdian-verify
